# Docker Registry & Repository for Production Deployments
IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=faris1015/xtern2026-miso
IMAGE_TAG=latest

# Port Mappings
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Google GEMINI API Configuration
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash
