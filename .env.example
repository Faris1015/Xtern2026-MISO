# Docker Registry & Repository for Production Deployments
IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=faris1015/xtern2026-miso
IMAGE_TAG=latest

# Port Mappings
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Google GEMINI API Configuration
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-3.6-flash

# MISO Live Operations & Data Exchange Configuration
# Public Operations API (No key required for real-time FuelMix & Demand)
MISO_PUBLIC_API_BASE=https://public-api.misoenergy.org
# MISO Data Exchange (Azure APIM Subscription Key for authenticated LMP pricing)
# Sign up at: https://data-exchange.misoenergy.org
MISO_API_KEY=your_miso_data_exchange_key_optional
MISO_CACHE_TTL_SECONDS=60

