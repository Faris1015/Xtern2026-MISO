# ==============================================================================
# MISO OmniSearch — Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Options:
#   - 'auto'   : Automatically detects local Ollama (localhost:11434).
#                If Ollama is running, uses local models for air-gapped NERC CIP compliance.
#                If Ollama is unavailable, seamlessly falls back to Google Gemini.
#                If both are offline, gracefully uses deterministic MISO rule templates.
#   - 'ollama' : Forces local Ollama inference only.
#   - 'gemini' : Forces Google Gemini cloud inference only.
LLM_PROVIDER=auto

# Ollama Local Configuration (Air-Gapped NERC CIP On-Premise Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=25.0

# Google Gemini API Configuration (Cloud Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# MISO Data Exchange / APIM Portal Integration (Optional)
MISO_API_KEY=
MISO_API_BASE_URL=https://api.misoenergy.org
